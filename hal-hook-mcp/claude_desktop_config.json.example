{
  "_comment": "Drop into ~/Library/Application Support/Claude/claude_desktop_config.json (macOS) or %APPDATA%\\Claude\\claude_desktop_config.json (Windows). Remove the _comment keys before use (JSON doesn't allow them).",
  "mcpServers": {
    "hal-hook": {
      "command": "python",
      "args": ["-m", "hal_hook_mcp"],
      "env": {
        "ADB": "C:\\Users\\pc\\AppData\\Local\\Android\\Sdk\\platform-tools\\adb.exe",
        "ADB_SERIAL": "",
        "HAL_HOOK_MCP_LOG": "INFO"
      }
    }
  }
}
