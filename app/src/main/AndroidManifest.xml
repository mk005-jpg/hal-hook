<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.secpen.halinject">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Camera2 warm-up: Export briefly opens the back camera so the hook
         gets to write a FRESH real_yuv.nv21 snapshot of the current scene.
         Without this, the backdrop in the composed BLOB is whatever stale
         frame the hook had cached from the last app that used the camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:label="HAL Inject"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
        android:requestLegacyExternalStorage="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".FramePlacementActivity"
            android:exported="false" />
    </application>
</manifest>
